generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  WAREHOUSE_STAFF
  STORE_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StoreType {
  DIRECT
  FRANCHISE
  WAREHOUSE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String     @map("password_hash")
  realName     String?    @map("real_name")
  phone        String?
  role         UserRole   @default(WAREHOUSE_STAFF)
  status       UserStatus @default(ACTIVE)
  storeId      Int?       @map("store_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  store          Store?          @relation("UserStore", fields: [storeId], references: [id])
  managedStore   Store?          @relation("StoreManager")
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  isRevoked Boolean  @default(false) @map("is_revoked")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Menu {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  path      String
  icon      String?
  sort      Int      @default(0)
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  parent    Menu?    @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  Menu[]   @relation("MenuHierarchy")
  roles     RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  id     Int      @id @default(autoincrement())
  role   UserRole
  menuId Int      @map("menu_id")

  menu   Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([role, menuId])
  @@map("role_menus")
}

model Store {
  id            Int         @id @default(autoincrement())
  name          String
  code          String      @unique
  type          StoreType   @default(DIRECT)
  status        StoreStatus @default(ACTIVE)
  country       String?
  province      String?
  city          String?
  district      String?
  address       String?
  longitude     Float?
  latitude      Float?
  contactName   String?     @map("contact_name")
  contactPhone  String?     @map("contact_phone")
  openTime      String?     @map("open_time")
  openDate      DateTime?   @map("open_date")
  closeDate     DateTime?   @map("close_date")
  area          Decimal?    @map("area")
  employeeCount Int?        @map("employee_count")
  managerId     Int?        @unique @map("manager_id")
  managerName   String?     @map("manager_name")
  remark        String?
  rentCost      Decimal?    @map("rent_cost")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  isDeleted     Boolean     @default(false) @map("is_deleted")

  manager       User?       @relation("StoreManager", fields: [managerId], references: [id])
  users         User[]      @relation("UserStore")

  @@map("stores")
}
